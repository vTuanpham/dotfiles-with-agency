{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "codex-wake hook", "timeout": 3}]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{"type": "command", "command": "codex-wake hook", "timeout": 3}]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{"type": "command", "command": "codex-wake hook", "async": true, "timeout": 60}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook codex"
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/libexec/agent-process-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "agent-baton guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__node_repl__(js|js_reset)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/libexec/chatgpt-browser-idle.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^mcp__.*([Bb]rowser|[Cc]hrome|[Cc]omputer|[Pp]laywright|[Pp]uppeteer|cua|[Dd]evtools)",
        "hooks": [
          {
            "type": "command",
            "command": "agent-baton guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "codex-wake hook", "timeout": 3}]
      },
      {
        "matcher": "^mcp__node_repl__js$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/libexec/chatgpt-browser-idle.py\"",
            "async": true,
            "timeout": 330
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "codex-wake hook", "timeout": 60}]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/libexec/chatgpt-browser-idle.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [{"type": "command", "command": "codex-wake hook", "timeout": 3}]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/libexec/chatgpt-browser-idle.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{"type": "command", "command": "codex-wake hook", "timeout": 3}]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/libexec/chatgpt-browser-idle.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}

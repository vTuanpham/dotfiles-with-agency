+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn metadata_is_not_a_test_run() {
+        let raw =
+            "free/model billing=free observations=5\nother/model billing=free observations=7\n";
+        for command in [
+            "jq '.items[] | select(test(\"free\"))' data.json",
+            "wc -l test_policy.py",
+            "agent-lab new --purpose 'test detection'",
+            "wc -l build_metadata.json",
+            "jq '.build' data.json",
+            "cat compile_statistics.txt",
+        ] {
+            let shown = summarize_output(raw, command, true);
+            assert!(!shown.contains("Test Results"), "{shown}");
+            assert!(!shown.contains("Build Summary"), "{shown}");
+            assert!(shown.contains("observations=5"), "{shown}");
+        }
+        let prose = "The failed connection passed through the fallback.\n";
+        assert!(!summarize_output(prose, "cat note.txt", true).contains("Test Results"));
+    }
+
+    #[test]
+    fn passing_titles_do_not_create_failures_or_counts() {
+        let raw = "ok 1 - handles failed saves\nok 2 - skips broken links\n# tests 2\n# pass 2\n# fail 0\n# skipped 0\n";
+        let shown = summarize_output(raw, "npm test", true);
+        assert!(shown.contains("# pass 2"), "{shown}");
+        assert!(shown.contains("# fail 0"), "{shown}");
+        assert!(!shown.contains("Failures:"), "{shown}");
+        assert!(!shown.contains("[ok] 0 passed"), "{shown}");
+    }
+
+    #[test]
+    fn runner_records_are_preserved_without_recounting() {
+        for raw in [
+            "test result: ok. 3 passed; 0 failed; 1 ignored; 0 measured; 0 filtered out; finished in 0.01s",
+            "================ 3 passed, 1 skipped in 0.12s ================",
+            "Tests:       3 passed, 3 total",
+            "Test Files:  1 passed (1)",
+            "ℹ pass 3\nℹ fail 0",
+            " 3 pass\n 0 fail",
+            "Ran 3 tests in 0.001s\n\nOK",
+            "\u{1b}[32m3 passed in 0.1s\u{1b}[0m",
+        ] {
+            let shown = summarize_output(raw, "run-checks", true);
+            assert!(shown.contains("Test Results:"), "{shown}");
+            assert!(shown.contains('3') || shown.contains("1 passed"), "{shown}");
+            assert!(!shown.contains("[ok] 0 passed"), "{shown}");
+        }
+    }
+
+    #[test]
+    fn failed_runs_keep_their_diagnostics() {
+        let raw = "first test\nAssertionError: expected saved data\n1 failed, 2 passed in 0.1s\n";
+        assert_eq!(summarize_output(raw, "pytest", false), raw);
+    }
+
+    #[test]
+    fn a_test_command_without_results_does_not_invent_success() {
+        let shown = summarize_output("No matching files\n", "npm test", true);
+        assert!(!shown.contains("Test Results"), "{shown}");
+        assert!(shown.contains("No matching files"), "{shown}");
+    }

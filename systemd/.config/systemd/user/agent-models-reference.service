[Unit]
Description=Check reference drift and poll benchmark changes
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/agent-models/environment
# stale exits 1 when something is out of date; that is its answer, not a failure
ExecStart=-%h/.local/bin/model-guide stale --live
# Conditional probes, per-source backoff, changed sources only; never auto-apply
ExecStart=%h/.local/bin/model-guide refresh --poll
TimeoutStartSec=600
Nice=10
